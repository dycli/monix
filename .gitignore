# Deny-by-default: nothing is trackable unless its type is whitelisted
# below. Type-level hygiene, not a content scanner: it blocks the classic
# stray-file commits (.env, .key, dumps), while a secret pasted into a
# whitelisted type still needs eyes on the diff. A new legitimate file
# type costs one line here.
*
!*/

# The flake and its documentation.
!*.nix
!*.md
!*.lock
!.gitignore
!.git-blame-ignore-revs

# Encrypted secrets (age ciphertext only).
!*.age

# The ship's own software.
!*.rs
!*.toml
!*.py
!*.sh
!*.sql
!*.nu.in
!*.qml

# Patches on packages the ship builds.
!*.patch

# Web sources.
!*.ts
!*.tsx
!*.css
!*.html
!*.jinja

# Assets: docs diagrams and the desktop wallpaper.
!*.svg
!*.jpg

# Hardware calibration: ICC display profiles, EasyEffects presets and
# their convolver impulse responses.
!*.icc
!*.json
!*.irs

# Tab-separated data: the lf filetype icon map.
!*.tsv

# hippo's transcript fixtures: real shapes, neutral text.

# Build artifacts and runtime junk trump the whitelist (later rules win).
target/
result
result-*
.direnv/
node_modules/
dist/
modules/web/atlas/site/public/data/
__pycache__/
*.qcow2
*.swp

# libri.is and app.libri.is: their Workers' configs, script and asset files.
!modules/ai/seat/libri-publish/*/worker.js
!modules/ai/seat/libri-publish/*/wrangler.jsonc
!modules/ai/seat/libri-publish/*/_headers
!modules/ai/seat/libri-publish/*/manifest.webmanifest
