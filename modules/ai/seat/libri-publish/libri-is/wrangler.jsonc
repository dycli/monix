// libri.is: the sign-in return page (worker.js) and, as static assets, the
// website, the Android releases at /android/ and the privacy policy at
// /privacy (assets/privacy.html). publish_libri_sites.sh copies them in
// before each upload: the website from the seat's website folder, the
// releases and the policy, which the newest release rendered, from its
// release folder.
{
  "name": "libri-is-site",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./assets" },
  "routes": [
    { "pattern": "libri.is", "custom_domain": true },
    { "pattern": "www.libri.is", "custom_domain": true }
  ],
  "workers_dev": false
}
